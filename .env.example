# AskJuno Backend Email Configuration (Server-Side Only - Never exposed to frontend)

# Destination email for consultation requests
DESTINATION_EMAIL=deviswarya21@gmail.com

# -------------------------------------------------------------
# OPTION 1: SMTP Configuration (Recommended)
# Works with Gmail (App Password), Outlook, Brevo, SendGrid, Amazon SES, etc.
# -------------------------------------------------------------
# For Gmail:
# 1. Enable 2-Step Verification in Google Account
# 2. Generate an App Password (Select App: "Mail", Device: "Other")
# 3. Paste details below:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password
# SMTP_FROM="AskJuno Notifications <notifications@askjuno.com>"

# -------------------------------------------------------------
# OPTION 2: Resend API Configuration
# -------------------------------------------------------------
# RESEND_API_KEY=re_123456789
# RESEND_FROM="AskJuno <onboarding@resend.dev>"
